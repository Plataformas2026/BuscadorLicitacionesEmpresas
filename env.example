# Copia este archivo a ".env" y rellena los valores reales.
# NUNCA subas el ".env" a git (ya está en .gitignore).

# --- Usado por app/ (Streamlit) en desarrollo local ---------------------
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave ANÓNIMA (anon/public): la usa SOLO la app de Streamlit, que solo
# necesita permiso de lectura (ver política de RLS en sql/schema.sql).
SUPABASE_ANON_KEY=TU_CLAVE_ANON_PUBLIC

# --- Usado por ingest/ (GitHub Actions / ejecución local de la ingesta) -
# Clave de SERVICE ROLE: bypassa la Row Level Security, tiene permiso de
# escritura/borrado. Guárdala SOLO como secret de GitHub Actions o en tu
# .env local si vas a lanzar la ingesta a mano. Nunca en el frontend ni
# en el repositorio.
SUPABASE_SERVICE_KEY=TU_CLAVE_SERVICE_ROLE

# --- Usado por ingest/sync_empresas_drive.py -----------------------------
# Contenido COMPLETO (todo el JSON en una sola línea) de la clave de la
# cuenta de servicio de Google -- ver README.md, sección "Google Drive",
# para cómo crearla y compartir el Excel con ella.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", "...":"..."}

# ID del fichero Excel en Google Drive (se saca de su URL para
# compartir: https://drive.google.com/file/d/AQUI_VA_EL_ID/view).
GOOGLE_DRIVE_FILE_ID=TU_ID_DE_ARCHIVO_EN_DRIVE
